# Create a .env file from this template and replace the placeholder before starting Docker.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Secret riêng cho phiên quản trị (bắt buộc, phải KHÁC JWT_SECRET).
ADMIN_JWT_SECRET=replace-with-another-random-secret-at-least-32-characters
# Thời hạn phiên đăng nhập của quản trị viên (giờ), mặc định 2.
ADMIN_SESSION_HOURS=2
WEB_PORT=8080
API_PORT=5000